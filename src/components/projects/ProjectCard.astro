---
/**
 * Öne çıkan proje kartı (Ana Sayfa) — referans: tam görsel, altta koyu lacivert şerit üzerinde
 * cyan büyük harfli sektör etiketi + beyaz başlık + sağda ok.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from '@/components/common/Icon.astro';
import TodoAsset from '@/components/common/TodoAsset.astro';

interface Props {
  title: string;
  sectorLabel: string;
  href: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
}

const { title, sectorLabel, href, image, imageAlt } = Astro.props;
---

<article class="group relative isolate overflow-hidden rounded-sm bg-navy-800 shadow-card">
  {
    image ? (
      <Picture
        src={image}
        alt={imageAlt ?? ''}
        formats={['avif', 'webp']}
        widths={[360, 540, 720]}
        sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
        class="aspect-[17/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        loading="lazy"
      />
    ) : (
      <TodoAsset name={`proje görseli · ${title}`} ratio="17 / 10" labelPosition="top" />
    )
  }
  <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-3 bg-navy-900/88 px-4 py-3 backdrop-blur-[2px]">
    <div class="min-w-0">
      <p class="text-[0.625rem] font-semibold tracking-[0.14em] text-cyan-300 uppercase">{sectorLabel}</p>
      <h3 class="mt-0.5 truncate text-small font-bold text-white">
        <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
      </h3>
    </div>
    <Icon name="ui/arrow-right" size={16} class="mb-0.5 text-white transition-transform group-hover:translate-x-0.5" />
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
</style>
