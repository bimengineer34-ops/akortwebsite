---
/**
 * Yasal metin sayfası (KVKK, Gizlilik, Çerez). Onaylı referans tasarımı yok — PageHero + prose şablonu.
 * Metin onaylanmamışsa (approved: false): production'da "hazırlanıyor" kutusu + noindex;
 * development'ta bölüm iskeleti TODO etiketiyle görünür.
 */
import { getEntry, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/common/Container.astro';
import Button from '@/components/common/Button.astro';
import { formatDate, isoDate } from '@/utils/date';

interface Props {
  id: 'kvkk' | 'gizlilik-politikasi' | 'cerez-politikasi';
  href: string;
}

const { id, href } = Astro.props;
const entry = await getEntry('legal', id);
if (!entry) throw new Error(`[legal] ${id} bulunamadı`);

const isDev = import.meta.env.DEV;
const showBody = entry.data.approved || isDev;
const { Content } = await render(entry);
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  heading={entry.data.title}
  breadcrumbs={[{ label: entry.data.title, href }]}
  heroImageTodo="yasal sayfa hero"
  noindex={!entry.data.approved}
>
  <section class="bg-white py-12 lg:py-14">
    <Container size="content">
      <div class="max-w-[46rem]">
        {
          !entry.data.approved && isDev && (
            <p class="mb-6 inline-block rounded-sm border border-dashed border-accent-500/60 px-2 py-1 text-[11px] font-semibold text-primary-700">
              TODO-CONTENT · Hukuki metin bekleniyor — yalnızca bölüm iskeleti. Production'da "hazırlanıyor" gösterilir ve noindex.
            </p>
          )
        }
        {
          entry.data.updatedDate && (
            <p class="mb-6 text-xs text-muted">
              Son güncelleme: <time datetime={isoDate(entry.data.updatedDate)}>{formatDate(entry.data.updatedDate)}</time>
            </p>
          )
        }
        {
          showBody ? (
            <div class="prose-akort text-[0.9375rem] leading-relaxed text-body">
              <Content />
            </div>
          ) : (
            <div class="card-surface p-(--space-card)">
              <p class="text-h3 font-bold text-heading">Bu metin hazırlanmaktadır</p>
              <p class="mt-2 text-small text-muted">
                {entry.data.title} kısa süre içinde bu sayfada yayınlanacaktır. Kişisel verilerinizle ilgili sorularınız için bizimle iletişime geçebilirsiniz.
              </p>
              <div class="mt-5">
                <Button href="/iletisim" size="md" variant="outline">
                  İletişim
                </Button>
              </div>
            </div>
          )
        }
      </div>
    </Container>
  </section>
</PageLayout>
