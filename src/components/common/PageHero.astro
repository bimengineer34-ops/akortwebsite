---
/**
 * İç sayfa hero'su (Hakkımızda, Hizmetler, Uzmanlık, Projeler, Blog, İletişim).
 * Referans: koyu lacivert, sağda gece çekimi bina + BIM wireframe, sağ kenarda dikey teknik notlar;
 * solda breadcrumb (ANA SAYFA › SAYFA), büyük açık renkli başlık (H1), 2–3 satır açıklama, opsiyonel CTA.
 *
 * TODO-ASSET: Sayfaya özel metinsiz hero render'ı. Gelene kadar BIM overlay + blueprint zemin.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Container from './Container.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Button from './Button.astro';
import bimOverlay from '@/assets/graphics/bim/bim-wireframe-overlay.svg?url';
import type { Crumb } from '@/utils/schema';

interface Props {
  title: string;
  /** Başlığın altındaki büyük, ince alt başlık (Blog referansı) */
  subtitle?: string;
  lead?: string;
  breadcrumbs: Crumb[];
  annotations?: string[][];
  cta?: { label: string; href: string };
  image?: ImageMetadata;
  imageTodo?: string;
}

const { title, subtitle, lead, breadcrumbs, annotations = [], cta, image, imageTodo = 'sayfa hero görseli' } = Astro.props;
const isDev = import.meta.env.DEV;
---

<section class="relative isolate overflow-hidden bg-navy-950 text-white" aria-labelledby="page-title">
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    {
      image ? (
        <Picture
          src={image}
          alt=""
          formats={['avif', 'webp']}
          widths={[768, 1280, 1920, 2560]}
          sizes="100vw"
          class="absolute inset-0 h-full w-full object-cover object-right"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <>
          <div class="absolute inset-0 bg-[radial-gradient(120%_90%_at_75%_40%,#24405e_0%,#152638_45%,#0b1a2b_100%)]" />
          <div class="bg-tech-grid absolute inset-0 opacity-50" />
          <img
            src={bimOverlay}
            alt=""
            width="1200"
            height="500"
            class="absolute top-1/2 right-[-10%] w-[80%] max-w-none -translate-y-1/2 opacity-80 md:w-[62%] lg:right-[8%] lg:w-[52%]"
            decoding="async"
          />
        </>
      )
    }
    <div class="absolute inset-0 bg-linear-to-r from-navy-950/95 via-navy-950/70 to-navy-950/0 lg:via-navy-950/50"></div>
    {
      isDev && !image && (
        <span class="absolute right-4 bottom-3 rounded-sm border border-dashed border-white/40 bg-navy-950/70 px-2 py-1 text-[11px] font-semibold tracking-wide">
          TODO-ASSET · {imageTodo}
        </span>
      )
    }
  </div>

  <Container size="content" class="relative grid min-h-[clamp(18rem,24vw,21rem)] content-center py-12 lg:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <h1 id="page-title" class="mt-4 text-display text-[#e6f4fd]">{title}</h1>
    {subtitle && <p class="mt-3 max-w-[38rem] text-[clamp(1.125rem,1rem+0.5vw,1.375rem)] leading-snug font-normal text-white/92">{subtitle}</p>}
    {lead && <p class:list={['max-w-[30rem] text-white/88', subtitle ? 'mt-3 text-small' : 'mt-4 text-lead']}>{lead}</p>}
    {
      cta && (
        <div class="mt-7">
          <Button href={cta.href} size="lg" class="border border-accent-500/60">
            {cta.label}
          </Button>
        </div>
      )
    }
  </Container>

  {
    annotations.length > 0 && (
      <ul class="absolute top-1/2 right-[4%] hidden -translate-y-1/2 flex-col gap-6 lg:flex" aria-label="Uzmanlık başlıkları">
        {annotations.map((lines) => (
          <li class="relative text-[0.6875rem] leading-snug font-semibold tracking-[0.14em] text-white/85 uppercase">
            <span aria-hidden="true" class="absolute top-1/2 right-[calc(100%+0.75rem)] h-px w-12 bg-white/30" />
            {lines.map((l) => (
              <span class="block">{l}</span>
            ))}
          </li>
        ))}
      </ul>
    )
  }
</section>
