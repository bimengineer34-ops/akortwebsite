---
import { site } from '@/data/site';
import { buildCanonical, buildTitle, type SeoProps } from '@/utils/seo';

type Props = SeoProps;

const {
  title,
  description = site.defaultDescription,
  canonical,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = buildTitle(title);
const canonicalUrl = canonical ? new URL(canonical, Astro.site) : buildCanonical(Astro.url.pathname, Astro.site);
// Varsayılan OG görseli: public/og-default.png (logo, 1200×630)
const imageUrl = Astro.site ? new URL(image ?? '/og-default.png', Astro.site).href : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl.href} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && <meta property="og:image:alt" content={imageAlt ?? site.name} />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
