---
/**
 * Asset Pack SVG ikonlarını inline basar. Kaynak dosyalara dokunmadan stroke `currentColor` yapılır,
 * böylece ikon rengi `text-*` utility'si ile kontrol edilir (açık zeminde accent, koyu bantta beyaz).
 */
import { getIcon, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Verilirse ikon anlamlı kabul edilir (role="img"); verilmezse dekoratif (aria-hidden). */
  label?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className, label, strokeWidth } = Astro.props;
const Svg = getIcon(name);
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

<Svg
  width={size}
  height={size}
  stroke="currentColor"
  stroke-width={strokeWidth}
  class:list={['max-w-none shrink-0', className]}
  focusable="false"
  {...a11y}
/>
