---
/**
 * "Öne Çıkan Hizmet" — referans: açık gradient zemin; solda eyebrow + H2 + metin + ✓ listesi + dolu buton;
 * sağda BIM wireframe'li bina görseli ve iki yanında uç noktalı çizgilerle bağlanan büyük harfli açıklamalar.
 *
 * TODO-ASSET: Temiz (metinsiz) BIM wireframe bina görseli — açıklamalar HTML ile çiziliyor,
 * görselde metin olmamalı. Görsel gelene kadar BIM overlay + yer tutucu.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Container from '@/components/common/Container.astro';
import Button from '@/components/common/Button.astro';
import Icon from '@/components/common/Icon.astro';
import bimOverlay from '@/assets/graphics/bim/bim-wireframe-overlay.svg?url';

interface Props {
  eyebrow: string;
  title: string;
  text: string;
  checklist: string[];
  cta: { label: string; href: string };
  calloutsLeft: string[][];
  calloutsRight: string[][];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, text, checklist, cta, calloutsLeft, calloutsRight, image, imageAlt = '' } = Astro.props;
const isDev = import.meta.env.DEV;
const leftTops = ['18%', '42%', '66%'];
const rightTops = ['10%', '36%', '62%'];
---

<section
  class="relative isolate overflow-hidden bg-[linear-gradient(180deg,#f3f7fa_0%,#e9f0f6_100%)] py-12 lg:py-10"
  aria-labelledby="featured-service-title"
>
  <Container size="wide" class="grid gap-10 lg:grid-cols-[minmax(0,26rem)_1fr] lg:items-center lg:gap-6">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="featured-service-title" class="mt-2 text-h2-lg">{title}</h2>
      <p class="mt-3 text-small text-body">{text}</p>
      <ul class="mt-4 space-y-2">
        {
          checklist.map((item) => (
            <li class="flex items-center gap-3 text-small text-body">
              <Icon name="process/check" size={18} strokeWidth={2.4} class="text-primary-700" />
              {item}
            </li>
          ))
        }
      </ul>
      <div class="mt-6">
        <Button href={cta.href} size="md">{cta.label}</Button>
      </div>
    </div>

    <!-- Görsel + açıklamalar -->
    <div class="relative">
      <div class="relative mx-auto aspect-[16/10] w-full max-w-[34rem] lg:max-w-[30rem] xl:max-w-[34rem]">
        {
          image ? (
            <Picture
              src={image}
              alt={imageAlt}
              formats={['avif', 'webp']}
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 40vw, 100vw"
              class="h-full w-full rounded-card object-cover shadow-[0_18px_40px_-18px_rgb(14_34_54/0.45)]"
              loading="lazy"
            />
          ) : (
            <div class="relative h-full w-full overflow-hidden rounded-sm bg-[linear-gradient(160deg,#dbe7f0_0%,#c3d5e3_60%,#a9bfd2_100%)]" aria-hidden="true">
              <img src={bimOverlay} alt="" width="1200" height="500" class="absolute inset-x-0 top-1/2 w-full -translate-y-1/2 opacity-90" decoding="async" />
              {isDev && (
                <span class="absolute bottom-2 left-2 rounded-sm border border-dashed border-primary-700/40 bg-white/80 px-2 py-1 text-[11px] font-semibold text-primary-700">
                  TODO-ASSET · BIM wireframe bina (metinsiz)
                </span>
              )}
            </div>
          )
        }
      </div>

      <!-- Açıklamalar: lg+ görselin iki yanında, altında liste olarak -->
      <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3 lg:mt-0" aria-label="Hizmet kapsamı">
        {
          calloutsLeft.map((lines, i) => (
            <li
              class="callout text-[0.6875rem] leading-snug font-semibold tracking-[0.12em] text-primary-800 uppercase lg:absolute lg:left-0"
              style={`--top:${leftTops[i] ?? '50%'}`}
            >
              {lines.map((l) => (
                <span class="block">{l}</span>
              ))}
              <span aria-hidden="true" class="callout-line callout-line--right" />
            </li>
          ))
        }
        {
          calloutsRight.map((lines, i) => (
            <li
              class="callout text-[0.6875rem] leading-snug font-semibold tracking-[0.12em] text-primary-800 uppercase lg:absolute lg:right-0"
              style={`--top:${rightTops[i] ?? '50%'}`}
            >
              {lines.map((l) => (
                <span class="block">{l}</span>
              ))}
              <span aria-hidden="true" class="callout-line callout-line--left" />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>

<style>
  .callout-line {
    display: none;
  }

  @media (min-width: 64rem) {
    .callout {
      top: var(--top);
    }

    .callout-line {
      display: block;
      position: absolute;
      top: 0.55em;
      width: 3.5rem;
      height: 1px;
      background: rgb(14 27 44 / 0.45);
    }

    /* Uçtaki nokta */
    .callout-line::after {
      content: '';
      position: absolute;
      top: -3px;
      width: 7px;
      height: 7px;
      border-radius: 9999px;
      background: var(--color-navy-900);
      box-shadow: 0 0 0 2px #fff;
    }

    .callout-line--right {
      left: calc(100% + 0.5rem);
    }

    .callout-line--right::after {
      right: -3px;
    }

    .callout-line--left {
      right: calc(100% + 0.5rem);
    }

    .callout-line--left::after {
      left: -3px;
    }
  }
</style>
