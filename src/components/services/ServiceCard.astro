---
/**
 * Hizmet kartı.
 * layout="stacked" (Ana Sayfa): ikon üstte, başlık, açıklama, "Detaylı Bilgi →".
 * layout="inline"  (Hakkımızda, Hizmetler): ikon solda, başlık/açıklama/link sağ kolonda.
 * layout="header"  (Uzmanlık › Çalışma Disiplinlerimiz): ikon + başlık aynı satırda, açıklama ve link tam genişlikte altta.
 */
import Icon from '@/components/common/Icon.astro';
import type { IconName } from '@/components/common/icons';

interface Props {
  title: string;
  description: string;
  icon: IconName;
  href: string;
  layout?: 'stacked' | 'inline' | 'header';
  headingLevel?: 'h3' | 'h4';
}

const { title, description, icon, href, layout = 'stacked', headingLevel: H = 'h3' } = Astro.props;
---

<article
  class:list={[
    'group card-surface relative h-full hover:-translate-y-0.5 hover:border-border-strong hover:shadow-card-hover',
    layout === 'header' ? 'p-4 xl:px-4 xl:py-5' : 'p-(--space-card)',
    layout === 'inline' ? 'grid grid-cols-[auto_1fr] gap-x-4' : 'flex flex-col',
  ]}
>
  {
    layout === 'header' ? (
      <div class="flex items-center gap-3">
        <Icon name={icon} size={34} strokeWidth={1.5} class="text-accent-600" />
        <H class="text-[0.9375rem] leading-snug font-bold">
          <a href={href} class="after:absolute after:inset-0 after:rounded-card focus-visible:outline-none">
            {title}
          </a>
        </H>
      </div>
    ) : (
      <Icon name={icon} size={layout === 'inline' ? 48 : 44} strokeWidth={1.5} class="text-accent-600" />
    )
  }
  <div class:list={['flex flex-col', layout !== 'inline' && 'flex-1']}>
    {
      layout !== 'header' && (
        <H class:list={['text-h3 font-bold', layout === 'stacked' && 'mt-5']}>
          <a href={href} class="after:absolute after:inset-0 after:rounded-card focus-visible:outline-none">
            {title}
          </a>
        </H>
      )
    }
    <p
      class:list={[
        'text-small text-muted',
        layout === 'inline' ? 'mt-1.5 mb-3' : layout === 'header' ? 'mt-3.5 mb-4' : 'mt-2.5 mb-5',
      ]}
    >
      {description}
    </p>
    <span class="mt-auto inline-flex items-center gap-1.5 text-small font-semibold text-primary-700" aria-hidden="true">
      Detaylı Bilgi
      <Icon name="ui/arrow-right" size={14} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
</style>
