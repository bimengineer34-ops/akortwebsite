---
/**
 * BIM Modelini İncele — IFC görüntüleyici arayüzü. Onaylı referans tasarımı yok: AKORT kart/buton/renk diliyle.
 * Motor (three.js + web-ifc + ThatOpen ≈ 1.5 MB JS + 1.6 MB WASM) yalnızca kullanıcı model seçince yüklenir (viewer.ts).
 * Gizlilik: IFC dosyası tarayıcıda işlenir, sunucuya gönderilmez.
 * Gelecek: ?model=<URL> (projenin bimModel.ifcUrl'i) ile aynı arayüzde uzak modeli açma — ifcUrl hazır olduğunda.
 */
import Icon from '@/components/common/Icon.astro';
---

<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]" data-bim-root>
  <div class="min-w-0">
    <!-- Araç çubuğu (model yüklenince görünür) -->
    <div class="mb-3 hidden flex-wrap items-center gap-2" data-bim-toolbar>
      <button type="button" class="bim-btn" data-act="fit">Görünümü Sıfırla</button>
      <span class="mx-1 hidden h-6 w-px bg-border sm:inline-block" aria-hidden="true"></span>
      <button type="button" class="bim-btn" data-act="hide" disabled>Seçileni Gizle</button>
      <button type="button" class="bim-btn" data-act="isolate" disabled>Seçileni İzole Et</button>
      <button type="button" class="bim-btn" data-act="show-all">Tümünü Göster</button>
      <span class="mx-1 hidden h-6 w-px bg-border sm:inline-block" aria-hidden="true"></span>
      <button type="button" class="bim-btn" data-act="open-other">Başka Dosya Aç</button>
    </div>

    <div class="relative overflow-hidden rounded-card border border-border bg-[#eef3f8]" style="height: clamp(22rem, 62vh, 40rem)">
      <!-- Three.js tuvali buraya eklenir -->
      <div class="absolute inset-0" data-bim-canvas></div>

      <!-- Boş durum / sürükle-bırak -->
      <div
        class="bg-tech-grid absolute inset-0 flex flex-col items-center justify-center gap-4 bg-white/85 p-6 text-center transition-colors"
        data-bim-empty
      >
        <span class="inline-flex size-14 items-center justify-center rounded-full bg-primary-700/10">
          <Icon name="services/bim-digital" size={30} strokeWidth={1.5} class="text-primary-700" />
        </span>
        <div>
          <p class="text-h3 font-bold text-heading">IFC modelinizi tarayıcıda inceleyin</p>
          <p class="mx-auto mt-1.5 max-w-md text-small text-muted">
            .ifc dosyasını buraya sürükleyin ya da seçin. Dosya cihazınızdan çıkmaz; tüm işlem tarayıcınızda yapılır.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button type="button" class="inline-flex items-center gap-2 rounded-control bg-primary-700 px-5 py-3 text-button font-semibold text-white hover:bg-primary-800" data-act="open">
            IFC Dosyası Seç
          </button>
          <button type="button" class="inline-flex items-center gap-2 rounded-control border border-primary-700 bg-white px-5 py-3 text-button font-semibold text-primary-700 hover:bg-primary-700 hover:text-white" data-act="sample">
            Test Modelini Aç
          </button>
        </div>
        <p class="text-xs text-muted">Desteklenen: IFC2x3, IFC4, IFC4x3 · Büyük modellerde işleme birkaç saniye sürebilir.</p>
        <input type="file" accept=".ifc" class="sr-only" tabindex="-1" aria-label="IFC dosyası seç" data-bim-file />
      </div>

      <!-- Yükleniyor -->
      <div class="absolute inset-0 hidden flex-col items-center justify-center gap-3 bg-white/90" data-bim-loading role="status" aria-live="polite">
        <span class="size-9 animate-spin rounded-full border-[3px] border-primary-700/25 border-t-primary-700" aria-hidden="true"></span>
        <p class="text-small font-semibold text-heading" data-bim-loading-text>Model işleniyor…</p>
      </div>

      <!-- Hata -->
      <p class="absolute inset-x-4 bottom-4 hidden rounded-control bg-danger px-4 py-3 text-small font-medium text-white shadow-float" role="alert" data-bim-error></p>
    </div>
    <p class="mt-2 text-xs text-muted">Fare: sol tuş döndür · sağ tuş kaydır · tekerlek yakınlaştır · tıklayarak öğe seç. Dokunmatik: tek parmak döndür, iki parmak kaydır/yakınlaştır.</p>
  </div>

  <!-- Yan panel -->
  <aside class="space-y-4" aria-label="Model bilgileri" data-bim-panel>
    <section class="card-surface p-4" aria-labelledby="bim-model-title">
      <h2 id="bim-model-title" class="text-h3 font-bold">Model</h2>
      <p class="mt-2 text-small text-muted" data-bim-summary>Henüz model yüklenmedi.</p>
    </section>

    <section class="card-surface hidden p-4" aria-labelledby="bim-storey-title" data-bim-storeys>
      <h2 id="bim-storey-title" class="text-h3 font-bold">Katlar</h2>
      <ul class="mt-3 space-y-1.5" data-bim-storey-list></ul>
    </section>

    <section class="card-surface hidden p-4" aria-labelledby="bim-disc-title" data-bim-disciplines>
      <h2 id="bim-disc-title" class="text-h3 font-bold">Disiplinler</h2>
      <ul class="mt-3 flex flex-wrap gap-2" data-bim-discipline-list></ul>
    </section>

    <section class="card-surface p-4" aria-labelledby="bim-props-title" aria-live="polite">
      <h2 id="bim-props-title" class="text-h3 font-bold">Öğe Özellikleri</h2>
      <div class="mt-2 text-small text-muted" data-bim-props>Bir öğeyi seçmek için modele tıklayın.</div>
    </section>
  </aside>
</div>

<style is:global>
  .bim-btn {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: #fff;
    color: var(--color-heading);
    font-size: var(--text-small);
    font-weight: 600;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }
  .bim-btn:hover:not(:disabled) {
    border-color: var(--color-primary-700);
    color: var(--color-primary-700);
  }
  .bim-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .bim-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: #fff;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-heading);
  }
  .bim-chip:hover {
    border-color: var(--color-primary-700);
    color: var(--color-primary-700);
  }
  .bim-chip[aria-pressed='true'] {
    background: var(--color-primary-800);
    border-color: var(--color-primary-800);
    color: #fff;
  }
</style>

<script>
  import type { AkortViewer, ModelSummary, SelectionInfo } from './viewer';

  const root = document.querySelector<HTMLElement>('[data-bim-root]');
  if (root) {
    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const canvas = q('[data-bim-canvas]')!;
    const empty = q('[data-bim-empty]')!;
    const loading = q('[data-bim-loading]')!;
    const loadingText = q('[data-bim-loading-text]')!;
    const errorEl = q('[data-bim-error]')!;
    const toolbar = q('[data-bim-toolbar]')!;
    const fileInput = q<HTMLInputElement>('[data-bim-file]')!;
    const summaryEl = q('[data-bim-summary]')!;
    const storeysBox = q('[data-bim-storeys]')!;
    const storeyList = q('[data-bim-storey-list]')!;
    const discBox = q('[data-bim-disciplines]')!;
    const discList = q('[data-bim-discipline-list]')!;
    const propsEl = q('[data-bim-props]')!;
    const hideBtn = q<HTMLButtonElement>('[data-act="hide"]')!;
    const isolateBtn = q<HTMLButtonElement>('[data-act="isolate"]')!;

    let viewer: AkortViewer | null = null;
    let creating: Promise<AkortViewer> | null = null;

    const MAX_MB = 300;
    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
      window.setTimeout(() => errorEl.classList.add('hidden'), 8000);
    };
    const setLoading = (on: boolean, text = 'Model işleniyor…') => {
      loading.classList.toggle('hidden', !on);
      loading.classList.toggle('flex', on);
      loadingText.textContent = text;
    };
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };

    const renderProps = (info: SelectionInfo | null) => {
      propsEl.replaceChildren();
      hideBtn.disabled = !info;
      isolateBtn.disabled = !info;
      if (!info) {
        propsEl.textContent = 'Bir öğeyi seçmek için modele tıklayın.';
        return;
      }
      propsEl.append(el('p', 'text-small font-bold text-heading', info.name));
      const meta = el('dl', 'mt-2 space-y-1 text-xs');
      for (const [k, v] of [['Kategori', info.category], ['GUID', info.guid]] as const) {
        const row = el('div', 'flex justify-between gap-3');
        row.append(el('dt', 'text-muted', k), el('dd', 'text-right font-medium break-all text-heading', v));
        meta.append(row);
      }
      propsEl.append(meta);
      for (const g of info.groups) {
        const det = el('details', 'mt-3 rounded-control border border-border');
        det.append(el('summary', 'cursor-pointer px-3 py-2 text-xs font-semibold text-primary-700', g.title));
        const dl = el('dl', 'space-y-1 border-t border-border px-3 py-2 text-xs');
        for (const r of g.rows) {
          const row = el('div', 'flex justify-between gap-3');
          row.append(el('dt', 'text-muted', r.name), el('dd', 'text-right font-medium break-words text-heading', r.value));
          dl.append(row);
        }
        det.append(dl);
        propsEl.append(det);
      }
    };

    const renderSummary = (s: ModelSummary) => {
      summaryEl.replaceChildren();
      summaryEl.append(el('span', 'block font-semibold text-heading', s.fileName), el('span', 'block', `${s.itemCount.toLocaleString('tr-TR')} öğe`));
      storeyList.replaceChildren();
      storeysBox.classList.toggle('hidden', s.storeys.length === 0);
      for (const st of s.storeys) {
        const li = el('li');
        const b = el('button', 'bim-chip w-full justify-between', st.name);
        b.type = 'button';
        b.append(el('span', 'text-muted', String(st.count)));
        b.addEventListener('click', () => void viewer?.isolateStorey(st.localId));
        li.append(b);
        storeyList.append(li);
      }
      discList.replaceChildren();
      discBox.classList.toggle('hidden', s.disciplines.length === 0);
      for (const d of s.disciplines) {
        const li = el('li');
        const b = el('button', 'bim-chip', `${d.label} (${d.count})`);
        b.type = 'button';
        b.addEventListener('click', () => void viewer?.isolateDiscipline(d.key));
        li.append(b);
        discList.append(li);
      }
    };

    const ensureViewer = async () => {
      if (viewer) return viewer;
      creating ??= import('./viewer').then(({ AkortViewer }) =>
        AkortViewer.create(canvas, { onSelect: renderProps, onError: showError }),
      );
      viewer = await creating;
      return viewer;
    };

    const openBuffer = async (data: Uint8Array, name: string) => {
      setLoading(true, 'Görüntüleyici yükleniyor…');
      try {
        const v = await ensureViewer();
        setLoading(true, 'Model işleniyor…');
        const summary = await v.loadIfc(data, name);
        renderSummary(summary);
        renderProps(null);
        empty.classList.add('hidden');
        toolbar.classList.remove('hidden');
        toolbar.classList.add('flex');
      } catch (err) {
        console.error(err);
        showError('Model açılamadı. Dosyanın geçerli bir IFC olduğundan emin olun.');
      } finally {
        setLoading(false);
      }
    };

    const openFile = async (file: File) => {
      if (!/\.ifc$/i.test(file.name)) return showError('Lütfen bir .ifc dosyası seçin.');
      if (file.size > MAX_MB * 1024 * 1024) return showError(`Dosya çok büyük (en fazla ${MAX_MB} MB).`);
      await openBuffer(new Uint8Array(await file.arrayBuffer()), file.name);
    };

    const loadSample = () =>
      fetch('/bim-samples/akort-test-duvar.ifc')
        .then((r) => r.arrayBuffer())
        .then((b) => openBuffer(new Uint8Array(b), 'akort-test-duvar.ifc'));

    const pick = () => fileInput.click();
    fileInput.addEventListener('change', () => {
      const f = fileInput.files?.[0];
      if (f) void openFile(f);
      fileInput.value = '';
    });

    root.addEventListener('click', (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-act]')?.dataset.act;
      if (!act) return;
      if (act === 'open' || act === 'open-other') pick();
      if (act === 'sample') void loadSample();
      if (act === 'fit') viewer?.fitView();
      if (act === 'hide') void viewer?.hideSelected();
      if (act === 'isolate') void viewer?.isolateSelected();
      if (act === 'show-all') void viewer?.showAll();
    });

    // /bim?ornek: test modelini otomatik aç (paylaşılabilir demo bağlantısı)
    // /bim?model=<yol>: projenin bimModel.ifcUrl'i — güvenlik için yalnızca aynı site (same-origin) modelleri açılır.
    const params = new URLSearchParams(location.search);
    const modelParam = params.get('model');
    if (modelParam) {
      const url = new URL(modelParam, location.href);
      if (url.origin !== location.origin) {
        showError('Yalnızca bu siteden sunulan modeller açılabilir. Kendi dosyanızı seçebilirsiniz.');
      } else {
        void fetch(url)
          .then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(new Error(String(r.status)))))
          .then((b) => openBuffer(new Uint8Array(b), decodeURIComponent(url.pathname.split('/').pop() ?? 'model.ifc')))
          .catch(() => showError('Model dosyası yüklenemedi.'));
      }
    } else if (params.has('ornek')) {
      void loadSample();
    }

    // Sürükle-bırak
    const frame = canvas.parentElement!;
    frame.addEventListener('dragover', (e) => {
      e.preventDefault();
      empty.classList.add('bg-primary-700/10');
    });
    frame.addEventListener('dragleave', () => empty.classList.remove('bg-primary-700/10'));
    frame.addEventListener('drop', (e) => {
      e.preventDefault();
      empty.classList.remove('bg-primary-700/10');
      const f = e.dataTransfer?.files?.[0];
      if (f) void openFile(f);
    });
  }
</script>
