---
/**
 * Header — referans: beyaz zemin, solda logo, ortada 7 linkli nav (aktif link alt çizgili),
 * sağda arama ikonu + lacivert "Proje Danışmanlığı Al →" butonu. 1024px altında MobileNav.
 *
 * Sabit (sticky) header: sayfa kaydırılınca üstte kalır. Kaydırma başlayınca gölge belirginleşir ve
 * header hafifçe incelir (data-scrolled). JS yalnızca tek bir pasif scroll dinleyicisi.
 */
import Container from '@/components/common/Container.astro';
import Button from '@/components/common/Button.astro';
import Icon from '@/components/common/Icon.astro';
import Logo from './Logo.astro';
import MobileNav from './MobileNav.astro';
import MegaMenu from './MegaMenu.astro';
import { mainNav, isActivePath } from '@/data/navigation';
import { site } from '@/data/site';

const pathname = Astro.url.pathname;
// Mega menüsü olan üst başlıklar
const megaFor: Record<string, 'services' | 'sectors' | 'about'> = { '/hakkimizda': 'about', '/hizmetler': 'services', '/uzmanlik-alanlari': 'sectors' };
---

<header
  class="sticky top-0 z-(--z-header) bg-white/95 shadow-(--shadow-header) backdrop-blur-md transition-shadow duration-(--duration-base) data-[scrolled=true]:shadow-[0_6px_24px_-12px_rgb(14_34_54/0.28)] supports-[backdrop-filter]:bg-white/90"
  data-site-header
>
  <Container
    size="content"
    class="flex h-(--header-height) items-center justify-between gap-6 transition-[height] duration-(--duration-base) lg:grid lg:grid-cols-[1fr_auto_1fr] [[data-scrolled=true]_&]:h-(--header-height-scrolled)"
  >
    <Logo
      class="origin-left justify-self-start transition-transform duration-(--duration-base) max-lg:scale-[0.85] [[data-scrolled=true]_&]:scale-[0.88]"
      layout="horizontal"
      height={44}
    />

    <nav aria-label="Ana menü" class="hidden lg:block">
      <ul class="flex items-stretch gap-5 xl:gap-7">
        {
          mainNav.map((item) => {
            const active = isActivePath(item.href, pathname);
            return (
              <li class="group flex h-(--header-height) items-center transition-[height] duration-(--duration-base) [[data-scrolled=true]_&]:h-(--header-height-scrolled)">
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'relative inline-block py-2 text-nav font-medium transition-colors duration-(--duration-fast)',
                    'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:rounded-full after:bg-primary-700 after:transition-transform after:duration-(--duration-base)',
                    active ? 'text-primary-700 after:scale-x-100' : 'text-heading hover:text-primary-700 after:scale-x-0 hover:after:scale-x-100',
                  ]}
                >
                  {item.label}
                </a>
                {megaFor[item.href] && <MegaMenu kind={megaFor[item.href]!} />}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 justify-self-end lg:gap-6">
      {/* Site içi arama: /arama (statik JSON indeks; Pagefind onaylanırsa değiştirilebilir) */}
      <a
        href="/arama"
        class="inline-flex size-11 items-center justify-center rounded-control text-heading transition-colors hover:text-primary-700"
        aria-label="Sitede ara"
      >
        <Icon name="ui/search" size={20} />
      </a>
      {/* Dil anahtarı yer tutucusu: İngilizce site etkinse yayın hattı (server/lib/ext/i18n.mjs) doldurur */}
      <span data-lang-switch hidden></span>
      <div class="hidden lg:block">
        <Button href={site.primaryCta.href} size="sm">
          {site.primaryCta.label}
        </Button>
      </div>
      <MobileNav />
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    let last: boolean | undefined;
    // Esc: açık mega menüden odağı çıkar (menü kapanır)
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
    });
    const update = () => {
      const scrolled = window.scrollY > 8;
      if (scrolled !== last) {
        header.dataset.scrolled = String(scrolled);
        last = scrolled;
      }
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
<style is:global>
  /* Dil anahtarı (İngilizce site etkinse yayın hattı doldurur): "TR | EN", geçerli dil vurgulu */
  .lang-slot { display: inline-flex; align-items: center; gap: 2px; font-size: 0.8125rem; font-weight: 600; }
  .lang-slot .lang-cur, .lang-slot .lang-opt { display: inline-flex; align-items: center; min-height: 2rem; padding: 0 0.55rem; border-radius: 0.4rem; line-height: 1; text-decoration: none; }
  .lang-slot .lang-cur { background: var(--color-step-bg); color: var(--color-primary-800); }
  .lang-slot .lang-opt { color: var(--color-heading); }
  .lang-slot .lang-opt:hover { color: var(--color-primary-700); background: var(--color-surface-soft); }
  .lang-banner { position: fixed; left: 1rem; bottom: 1rem; z-index: 70; max-width: 22rem; padding: 0.9rem 1rem; background: #fff; color: var(--color-heading); border: 1px solid var(--color-border); border-radius: 0.75rem; box-shadow: 0 12px 32px -12px rgb(14 34 54 / 0.35); font-size: 0.875rem; line-height: 1.45; }
  .lang-banner p { margin: 0 0 0.6rem; }
  .lang-banner small { display: block; color: var(--color-muted); }
  .lang-banner .row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .lang-banner button { cursor: pointer; border-radius: 0.5rem; padding: 0.5rem 0.8rem; font: inherit; font-weight: 600; border: 1px solid var(--color-border-strong); background: #fff; color: var(--color-heading); }
  .lang-banner button.primary { background: var(--color-primary-700); border-color: var(--color-primary-700); color: #fff; }
  @media (max-width: 640px) { .lang-banner { left: 0.75rem; right: 0.75rem; max-width: none; } }
  /* Dar ekranda üst çubuğa sığmaz: dil anahtarı mobil menü panelinde gösterilir; masaüstünde üst çubukta */
  [data-site-header] .lang-slot { display: none; }
  @media (min-width: 1024px) { [data-site-header] .lang-slot { display: inline-flex; } }
  [data-site-header] dialog .lang-slot { display: inline-flex; margin-left: auto; margin-right: 0.5rem; }
</style>

<script>
  // Dil tercihi: yalnızca İngilizce site etkinse (dil anahtarı doldurulmuşsa) çalışır. Tercih tarayıcıda (localStorage) tutulur; çerez yok.
  const opt = document.querySelector<HTMLAnchorElement>('a.lang-opt[hreflang]');
  if (opt) {
    const KEY = 'akort-lang';
    const target = opt.hreflang;
    const get = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
    const set = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* özel pencere */ } };
    document.querySelectorAll<HTMLAnchorElement>('a.lang-opt[hreflang]').forEach((a) => a.addEventListener('click', () => set(a.hreflang)));
    const isHome = location.pathname === '/' || location.pathname === '';
    if (isHome && target === 'en') {
      const pref = get();
      if (pref === 'en') {
        location.replace(opt.href);
      } else if (!pref && navigator.language.toLowerCase().startsWith('en')) {
        const box = document.createElement('div');
        box.className = 'lang-banner';
        box.setAttribute('role', 'dialog');
        box.setAttribute('aria-label', 'Language / Dil');
        const p = document.createElement('p');
        p.textContent = 'This website is also available in English.';
        const sm = document.createElement('small');
        sm.textContent = 'Bu site İngilizce olarak da mevcut.';
        p.append(sm);
        const row = document.createElement('div');
        row.className = 'row';
        const yes = document.createElement('button');
        yes.className = 'primary';
        yes.textContent = 'View in English';
        yes.addEventListener('click', () => { set('en'); location.href = opt.href; });
        const no = document.createElement('button');
        no.textContent = 'Türkçe devam et';
        const close = () => { set('tr'); box.remove(); };
        no.addEventListener('click', close);
        row.append(yes, no);
        box.append(p, row);
        document.body.append(box);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); }, { once: true });
      }
    }
  }
</script>
