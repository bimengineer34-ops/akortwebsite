---
/**
 * Footer — referans: çok koyu lacivert; solda logo, ortada nav + sosyal ikonlar, sağda iletişim;
 * alt satırda © ve yasal linkler (Gizlilik Politikası | KVKK | Çerez Tercihleri).
 * Doğrulanmamış iletişim bilgileri ve sosyal linkler production'da gösterilmez.
 */
import Container from '@/components/common/Container.astro';
import Icon from '@/components/common/Icon.astro';
import Logo from './Logo.astro';
import { mainNav } from '@/data/navigation';
import { legalNav } from '@/data/footer';
import { site } from '@/data/site';
import { publishable } from '@/utils/verified';

const email = publishable(site.contact.email);
const phone = publishable(site.contact.phone);
const city = publishable(site.contact.city);
const socials = site.social
  .map((s) => ({ label: s.label, href: publishable(s.href) }))
  .filter((s): s is { label: typeof s.label; href: string } => !!s.href);

const isDev = import.meta.env.DEV;
const year = new Date().getFullYear();
// TODO-ASSET-ICON: Sosyal medya marka ikonları (resmi işaretler) bekleniyor; geçici kısaltmalar.
const socialAbbr = { LinkedIn: 'in', YouTube: 'yt', Instagram: 'ig' } as const;
---

<footer class="bg-navy-950 text-on-dark-muted">
  <Container size="wide" class="pt-12 pb-8 lg:pt-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-12">
      <Logo tone="dark" height={72} />

      <div class="flex flex-col gap-6 lg:items-center">
        <nav aria-label="Alt menü">
          <ul class="flex flex-wrap gap-x-6 gap-y-3 text-small">
            {
              mainNav.map((item) => (
                <li>
                  <a href={item.href} class="text-white/85 transition-colors hover:text-white">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {
          socials.length > 0 && (
            <ul class="flex items-center gap-4" aria-label="Sosyal medya">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    class="inline-flex size-9 items-center justify-center rounded-full text-[0.75rem] font-bold text-white/85 transition-colors hover:bg-white/10 hover:text-white"
                    aria-label={s.label}
                    rel="noopener"
                    target="_blank"
                    data-todo-asset={isDev ? `social-${s.label}` : undefined}
                  >
                    {socialAbbr[s.label]}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        (email || phone || city) && (
          <address class="flex flex-col gap-3 text-small not-italic md:col-span-2 lg:col-span-1 lg:items-end">
            {email && (
              <a href={`mailto:${email}`} class="inline-flex items-center gap-3 text-white/85 hover:text-white">
                <Icon name="ui/mail" size={18} class="text-white/70" />
                {email}
              </a>
            )}
            {phone && (
              <a href={`tel:${phone.replace(/\s/g, '')}`} class="inline-flex items-center gap-3 text-white/85 hover:text-white">
                <Icon name="ui/phone" size={18} class="text-white/70" />
                {phone}
              </a>
            )}
            {city && (
              <span class="inline-flex items-center gap-3 text-white/85">
                <Icon name="ui/location" size={18} class="text-white/70" />
                {city}
              </span>
            )}
          </address>
        )
      }
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-on-dark-line pt-6 text-[0.75rem] md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.name}. Tüm hakları saklıdır.</p>
      <ul class="flex flex-wrap items-center gap-y-2">
        {
          legalNav.map((item, i) => (
            <li class="flex items-center">
              {i > 0 && <span class="mx-3 text-white/30" aria-hidden="true">|</span>}
              <a href={item.href} class="hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
