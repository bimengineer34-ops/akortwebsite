---
/**
 * Blog yan paneli — referans: 3 kart. Kategoriler (ikon, ad, yuvarlak sayı rozeti; "Tüm Yazılar →"),
 * Popüler Yazılar (küçük görsel + başlık + tarih), Etiketler (açık mavi çipler).
 * Sayılar ve etiketler yayınlanmış yazılardan hesaplanır — sabit sayı yazılmaz.
 */
import Icon from '@/components/common/Icon.astro';
import BlogCover from './BlogCover.astro';
import { blogListing } from '@/data/blog';
import { formatDate, isoDate } from '@/utils/date';
import {
  categoryCounts,
  categoryHref,
  categoryIcons,
  popularPosts,
  postHref,
  tagCloud,
  tagHref,
  type BlogPost,
} from '@/utils/blog';

interface Props {
  posts: BlogPost[];
  activeCategory?: string;
  activeTag?: string;
}

const { posts, activeCategory, activeTag } = Astro.props;
const categories = categoryCounts(posts);
const popular = popularPosts(posts);
const tags = tagCloud(posts);
const { sidebar } = blogListing;
---

<aside class="space-y-5" aria-label="Blog yan paneli">
  <section class="card-surface p-(--space-card)" aria-labelledby="sb-categories">
    <div class="flex items-center justify-between">
      <h2 id="sb-categories" class="text-h3 font-bold">{sidebar.categories}</h2>
      <a href="/blog" class="inline-flex items-center gap-1 border-b border-primary-700/60 pb-0.5 text-xs font-semibold text-primary-700">
        {sidebar.all}
        <Icon name="ui/arrow-right" size={12} />
      </a>
    </div>
    <ul class="mt-3 divide-y divide-border">
      <li>
        <a
          href="/blog"
          class:list={['flex items-center gap-3 py-2.5 text-small hover:text-primary-700', !activeCategory && !activeTag ? 'font-bold text-primary-700' : 'text-heading']}
          aria-current={!activeCategory && !activeTag ? 'page' : undefined}
        >
          <Icon name="_pending/grid" size={20} strokeWidth={1.6} class="text-accent-600" />
          <span class="flex-1">Tümü</span>
          <span class="inline-flex min-w-7 justify-center rounded-full bg-surface-soft px-2 py-0.5 text-xs text-muted">{posts.length}</span>
        </a>
      </li>
      {
        categories.map(({ category, count }) => {
          const active = activeCategory === category;
          return (
            <li>
              <a
                href={categoryHref(category)}
                class:list={['flex items-center gap-3 py-2.5 text-small hover:text-primary-700', active ? 'font-bold text-primary-700' : 'text-heading']}
                aria-current={active ? 'page' : undefined}
              >
                <Icon name={categoryIcons[category]} size={20} strokeWidth={1.6} class="text-accent-600" />
                <span class="flex-1">{category}</span>
                <span class="inline-flex min-w-7 justify-center rounded-full bg-surface-soft px-2 py-0.5 text-xs text-muted">{count}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    popular.length > 0 && (
      <section class="card-surface p-(--space-card)" aria-labelledby="sb-popular">
        <h2 id="sb-popular" class="text-h3 font-bold">
          {sidebar.popular}
        </h2>
        <ul class="mt-3 divide-y divide-border">
          {popular.map((p) => (
            <li class="py-3 first:pt-1">
              <a href={postHref(p)} class="group grid grid-cols-[4.5rem_1fr] items-center gap-3">
                <span class="block overflow-hidden rounded-sm">
                  <BlogCover image={p.data.cover} category={p.data.category} ratio="1 / 1" widths={[96, 144]} sizes="72px" iconSize={22} class="w-full" />
                </span>
                <span>
                  <span class="block text-small leading-snug font-bold text-heading group-hover:text-primary-700">{p.data.title}</span>
                  <time datetime={isoDate(p.data.pubDate)} class="mt-1 block text-xs text-muted">
                    {formatDate(p.data.pubDate)}
                  </time>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    tags.length > 0 && (
      <section class="card-surface p-(--space-card)" aria-labelledby="sb-tags">
        <h2 id="sb-tags" class="text-h3 font-bold">
          {sidebar.tags}
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map((t) => (
            <li>
              <a
                href={tagHref(t)}
                class:list={[
                  'inline-block rounded-control px-2.5 py-1 text-xs transition-colors',
                  activeTag === t ? 'bg-primary-700 text-white' : 'bg-[#eaf2f8] text-primary-800 hover:bg-step-bg',
                ]}
                aria-current={activeTag === t ? 'page' : undefined}
              >
                {t}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</aside>
