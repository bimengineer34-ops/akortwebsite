---
/**
 * Öne çıkan yazı — referans: beyaz kart; solda eyebrow, açık teal kategori rozeti, büyük başlık, özet,
 * "Devamını Oku →"; sağda büyük görsel ve altında tarih · yazar · okuma süresi.
 */
import type { ImageMetadata } from 'astro';
import Icon from '@/components/common/Icon.astro';
import BlogCover from './BlogCover.astro';
import { formatDate, isoDate } from '@/utils/date';

interface Props {
  eyebrow: string;
  title: string;
  excerpt: string;
  category: string;
  categoryHref: string;
  date: Date;
  author: string;
  minutes: number;
  href: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
}

const { eyebrow, title, excerpt, category, categoryHref, date, author, minutes, href, image, imageAlt } = Astro.props;
---

<article class="group card-surface relative grid overflow-hidden md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]" aria-labelledby="featured-post-title">
  <div class="flex flex-col p-(--space-card) md:py-6 md:pr-2">
    <p class="eyebrow">{eyebrow}</p>
    <a href={categoryHref} class="relative z-10 mt-3 self-start rounded-control bg-step-bg/70 px-3 py-1 text-xs font-semibold text-primary-800 hover:bg-step-bg">
      {category}
    </a>
    <h2 id="featured-post-title" class="mt-3 text-h2-lg">
      <a href={href} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
    </h2>
    <p class="mt-3 text-small text-muted">{excerpt}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-small font-semibold text-primary-700 md:mt-auto" aria-hidden="true">
      Devamını Oku
      <Icon name="ui/arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
  <div class="flex flex-col">
    <div class="overflow-hidden">
      <BlogCover image={image} alt={imageAlt} category={category} ratio="16 / 10" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" iconSize={92} class="w-full" />
    </div>
    <ul class="flex flex-wrap items-center justify-end gap-x-6 gap-y-2 px-(--space-card) py-3 text-xs text-muted">
      <li class="inline-flex items-center gap-1.5">
        <Icon name="services/project-management" size={15} strokeWidth={2} />
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
      </li>
      <li class="inline-flex items-center gap-1.5">
        <Icon name="_pending/user" size={15} strokeWidth={2} />
        {author}
      </li>
      <li class="inline-flex items-center gap-1.5">
        <Icon name="_pending/clock" size={15} strokeWidth={2} />
        {minutes} dk okuma
      </li>
    </ul>
  </div>
</article>

<style>
  article:has(h2 a:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
</style>
