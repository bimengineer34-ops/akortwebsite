---
/**
 * Blog kapak görseli. Yazıya gerçek kapak (cover) eklenmişse onu gösterir (Astro Picture, avif/webp).
 * Eklenmemişse markaya uygun, KATEGORİYE ÖZEL tasarlanmış bir kapak üretir: lacivert-mavi gradyan, teknik ızgara,
 * BIM tel kafes çizgileri ve kategori ikonu. Görselde yazı yoktur (başlık/kategori HTML'de) → her kartta tutarlı ve temiz görünür.
 * TODO-ASSET: gerçek kapak görselleri geldikçe yazının frontmatter'ına `cover` + `coverAlt` eklenir (panelden de seçilebilir).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from '@/components/common/Icon.astro';
import type { IconName } from '@/components/common/icons';
import bimOverlay from '@/assets/graphics/bim/bim-wireframe-overlay.svg?url';

interface Props {
  image?: ImageMetadata | undefined;
  alt?: string | undefined;
  category?: string | undefined;
  /** CSS aspect-ratio, ör. "16 / 10" */
  ratio?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Kategori ikonunun boyutu (px) */
  iconSize?: number;
}

const { image, alt = '', category, ratio = '16 / 10', widths = [360, 540, 720], sizes = '(min-width: 1024px) 30vw, 100vw', loading = 'lazy', class: className, iconSize = 64 } = Astro.props;

interface Theme {
  icon: IconName;
  bg: string;
}
const themes: Record<string, Theme> = {
  'BIM & Dijital Mühendislik': { icon: 'services/bim-digital', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#10416b_55%,#0b6f9f_100%)]' },
  Enerji: { icon: 'services/energy', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0d3f5c_55%,#13808f_100%)]' },
  MEP: { icon: 'services/mep', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#17344f_55%,#2a6f9f_100%)]' },
  'Proje Yönetimi': { icon: 'services/project-management', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#14335a_55%,#1e5f9c_100%)]' },
  'Teknik Danışmanlık': { icon: 'services/owner-advisory', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0f3552_55%,#0b5d86_100%)]' },
  Sürdürülebilirlik: { icon: 'services/building-performance', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0c3f4f_55%,#188a8a_100%)]' },
  // Proje kapakları: sektör etiketleri ve yazılım
  'Sağlık Yapıları': { icon: 'expertise/health', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0f3b63_55%,#188a8a_100%)]' },
  'Eğitim Yapıları': { icon: 'expertise/education', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#14335a_55%,#2a6f9f_100%)]' },
  Kampüs: { icon: 'expertise/campus', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0f3552_55%,#1e5f9c_100%)]' },
  'Ticari Yapılar': { icon: 'expertise/commercial', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#10416b_55%,#0b6f9f_100%)]' },
  'Mevcut Yapılar': { icon: 'expertise/analysis', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#17344f_55%,#13808f_100%)]' },
  'Karma Kullanım': { icon: '_pending/layers', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0d3f5c_55%,#2a6f9f_100%)]' },
  'Kamu Yapıları': { icon: 'services/owner-advisory', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#0f3552_55%,#0b5d86_100%)]' },
  'Endüstriyel Yapılar': { icon: '_pending/gear', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#17344f_55%,#2a6f9f_100%)]' },
  Yazılım: { icon: '_pending/code', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#10416b_55%,#1e8fb5_100%)]' },
};
const fallback: Theme = { icon: 'services/engineering-consulting', bg: 'bg-[linear-gradient(135deg,#0b1a2b_0%,#10416b_55%,#0b6f9f_100%)]' };
const theme = (category && themes[category]) || fallback;
---

<div class:list={['relative isolate overflow-hidden bg-navy-900', className]} style={`aspect-ratio: ${ratio}`}>
  {
    image ? (
      <Picture src={image} alt={alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} class="absolute inset-0 h-full w-full object-cover" loading={loading} />
    ) : (
      <div aria-hidden="true" class="absolute inset-0">
        <div class:list={['absolute inset-0', theme.bg]} />
        <div class="bg-tech-grid absolute inset-0 opacity-35" />
        <img src={bimOverlay} alt="" width="1200" height="500" class="absolute top-1/2 right-[-18%] w-[110%] max-w-none -translate-y-1/2 opacity-60" decoding="async" loading="lazy" />
        <div class="absolute inset-0 bg-linear-to-tr from-transparent via-white/[0.04] to-white/[0.14]" />
        <span class="absolute bottom-[8%] left-[6%] inline-flex items-center justify-center rounded-full bg-white/12 p-[0.9em] text-white/95 ring-1 ring-white/25 backdrop-blur-[2px]">
          <Icon name={theme.icon} size={iconSize} strokeWidth={1.4} />
        </span>
      </div>
    )
  }
</div>
