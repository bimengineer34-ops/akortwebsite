---
/**
 * Yatay blog kartı (Ana Sayfa) — referans: beyaz kart, solda görsel (~%40), sağda 2 satır başlık,
 * tarih, 2 satır özet ve "Devamını Oku →".
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from '@/components/common/Icon.astro';
import TodoAsset from '@/components/common/TodoAsset.astro';
import { formatDate, isoDate } from '@/utils/date';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  href: string;
  image?: ImageMetadata | undefined;
  imageAlt?: string | undefined;
}

const { title, excerpt, date, href, image, imageAlt } = Astro.props;
---

<article class="group card-surface relative grid grid-cols-[40%_1fr] gap-4 p-2.5 hover:shadow-card-hover">
  <div class="overflow-hidden rounded-sm">
    {
      image ? (
        <Picture
          src={image}
          alt={imageAlt ?? ''}
          formats={['avif', 'webp']}
          widths={[240, 360, 480]}
          sizes="(min-width: 1024px) 13vw, 40vw"
          class="aspect-[3/2] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
        />
      ) : (
        <TodoAsset name="blog kapak" ratio="3 / 2" class="h-full" />
      )
    }
  </div>
  <div class="flex min-w-0 flex-col py-1 pr-1.5">
    <h3 class="line-clamp-2 text-small leading-snug font-bold text-heading">
      <a href={href} class="after:absolute after:inset-0 after:rounded-card focus-visible:outline-none">{title}</a>
    </h3>
    <time datetime={isoDate(date)} class="mt-1 text-xs text-muted">{formatDate(date)}</time>
    <p class="mt-1.5 line-clamp-2 text-xs text-muted">{excerpt}</p>
    <span class="mt-auto inline-flex items-center gap-1.5 pt-2 text-xs font-semibold text-primary-700" aria-hidden="true">
      Devamını Oku
      <Icon name="ui/arrow-right" size={13} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
</style>
