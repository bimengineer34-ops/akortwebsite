---
/**
 * Çalışma Modelimiz — 5 adımın ayrıntılı anlatımı. Onaylı referans tasarımı yok; onaylı component'lerle sade şablon:
 * PageHero → giriş + adım özeti (ProcessTimeline) → her adım için ayrıntı bölümü (#id) → CTA.
 * Ana Sayfa "Çalışma Modelimiz" bölümündeki "Süreç Hakkında" ve Hakkımızda menüsü buraya gelir.
 */
import { heroImages } from '@/data/images';
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/common/Container.astro';
import Icon from '@/components/common/Icon.astro';
import CTASection from '@/components/common/CTASection.astro';
import ProcessTimeline from '@/components/common/ProcessTimeline.astro';
import { workModelPage, workSteps } from '@/data/workModel';
import { getService, navLabel, serviceHref } from '@/data/serviceCatalog';
import { servicesCta } from '@/data/servicesPage';

const overview = workSteps.map((s) => ({ number: s.number, title: s.title, description: s.summary }));
---

<PageLayout
  title="Çalışma Modelimiz"
  description="AKORT Mühendislik çalışma modeli: ihtiyaç analizi, strateji, tasarım koordinasyonu, teknik kontrol ve işletme optimizasyonu adımları."
  heading={workModelPage.title}
  lead={workModelPage.lead}
  breadcrumbs={[
    { label: 'Hakkımızda', href: '/hakkimizda' },
    { label: 'Çalışma Modelimiz', href: '/calisma-modeli' },
  ]}
  heroImage={heroImages.calismaModeli}
>
  <section class="bg-white py-12 lg:py-14" aria-labelledby="work-intro-title">
    <Container size="wide">
      <p class="eyebrow">{workModelPage.eyebrow}</p>
      <h2 id="work-intro-title" class="mt-2 text-h2-lg">Beş Adımda Süreç Yönetimi</h2>
      <p class="mt-4 max-w-3xl text-[0.9375rem] leading-relaxed text-body">{workModelPage.intro}</p>
      <div class="mt-9">
        <ProcessTimeline steps={overview} />
      </div>
      <ul class="mt-8 flex flex-wrap gap-2.5" aria-label="Adımlara git">
        {
          workSteps.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                class="inline-flex items-center gap-2 rounded-control border border-border bg-white px-3.5 py-2 text-small font-medium text-heading transition-colors hover:border-primary-700 hover:text-primary-700"
              >
                <span class="font-bold text-primary-700">{s.number}</span>
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-xs text-muted">{workModelPage.note}</p>
    </Container>
  </section>

  {
    workSteps.map((step, i) => (
      <section id={step.id} class:list={['scroll-mt-24 py-12 lg:py-14', i % 2 === 0 ? 'bg-surface-soft' : 'bg-white']} aria-labelledby={`${step.id}-title`}>
        <Container size="wide">
          <div class="flex items-center gap-4">
            <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-full bg-step-bg text-body font-bold text-primary-800" aria-hidden="true">
              {step.number}
            </span>
            <div>
              <p class="eyebrow">Adım {step.number}</p>
              <h2 id={`${step.id}-title`} class="text-h2">
                {step.title}
              </h2>
            </div>
          </div>
          <p class="mt-5 max-w-3xl text-[0.9375rem] leading-relaxed text-body">{step.intro}</p>

          <div class="mt-7 grid gap-4 lg:grid-cols-3">
            <div class="card-surface p-(--space-card) lg:col-span-1">
              <Icon name={step.icon} size={32} strokeWidth={1.5} class="text-accent-600" />
              <h3 class="mt-3 text-h3 font-bold">Neler Yapılır?</h3>
              <ul class="mt-3 space-y-2">
                {step.activities.map((a) => (
                  <li class="flex gap-3 text-small text-body">
                    <Icon name="process/check" size={16} strokeWidth={2.4} class="mt-0.5 text-primary-700" />
                    {a}
                  </li>
                ))}
              </ul>
            </div>
            <div class="card-surface p-(--space-card)">
              <Icon name="process/report" size={32} strokeWidth={1.5} class="text-accent-600" />
              <h3 class="mt-3 text-h3 font-bold">Çıktılar</h3>
              <ul class="mt-3 space-y-2">
                {step.outputs.map((o) => (
                  <li class="flex gap-3 text-small text-body">
                    <span aria-hidden="true" class="mt-[0.6em] size-1 shrink-0 rounded-full bg-primary-700" />
                    {o}
                  </li>
                ))}
              </ul>
            </div>
            <div class="card-surface p-(--space-card)">
              <Icon name="process/support" size={32} strokeWidth={1.5} class="text-accent-600" />
              <h3 class="mt-3 text-h3 font-bold">Sizden Beklenenler</h3>
              <ul class="mt-3 space-y-2">
                {step.inputs.map((o) => (
                  <li class="flex gap-3 text-small text-body">
                    <span aria-hidden="true" class="mt-[0.6em] size-1 shrink-0 rounded-full bg-primary-700" />
                    {o}
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <h3 class="mt-8 text-small font-bold tracking-[0.08em] text-primary-800 uppercase">Bu adımda ilgili hizmetler</h3>
          <ul class="mt-3 flex flex-wrap gap-2.5">
            {step.services.map((slug) => {
              const sv = getService(slug);
              return (
                <li>
                  <a
                    href={serviceHref(sv.slug)}
                    class="inline-flex items-center gap-2 rounded-control border border-border bg-white px-3.5 py-2 text-small font-medium text-heading transition-colors hover:border-primary-700 hover:text-primary-700"
                  >
                    <Icon name={sv.icon} size={18} strokeWidth={1.6} class="text-accent-600" />
                    {navLabel(sv)}
                  </a>
                </li>
              );
            })}
          </ul>
        </Container>
      </section>
    ))
  }

  <CTASection {...servicesCta} headingId="work-cta-title" />
</PageLayout>
