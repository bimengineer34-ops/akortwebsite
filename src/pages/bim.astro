 * Onaylı referans tasarımı yok: PageHero + AKORT kart dili. noindex (araç sayfası, içerik değil).
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/common/Container.astro';
import BimViewer from '@/components/bim/BimViewer.astro';
---

<PageLayout
  title="BIM Modelini İncele"
