---
/**
 * Blog yazısı detayı. Onaylı referans görseli YOK — yeni tasarım üretilmez; onaylı component'ler
 * (PageHero, prose, BlogSidebar, BlogGridCard, NewsletterBand) kullanılır.
 * SEO: BlogPosting şeması, ilgili hizmetlere iç link (Master Prompt §20).
 */
import { heroImages } from '@/data/images';
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/common/Container.astro';
import Icon from '@/components/common/Icon.astro';
import BlogSidebar from '@/components/blog/BlogSidebar.astro';
import BlogGridCard from '@/components/blog/BlogGridCard.astro';
import NewsletterBand from '@/components/blog/NewsletterBand.astro';
import { services, serviceHref } from '@/data/services';
import { blogHero } from '@/data/blog';
import { formatDate, isoDate } from '@/utils/date';
import { blogPostingSchema } from '@/utils/schema';
import {
  categoryHref,
  getBlogPosts,
  postExcerpt,
  postHref,
  postReadingTime,
  tagHref,
  type BlogPost,
} from '@/utils/blog';

export const getStaticPaths = (async () => {
  const allPosts = await getBlogPosts();
  return allPosts.map((post) => ({ params: { slug: post.id }, props: { post, allPosts } }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
  allPosts: BlogPost[];
}

const { post, allPosts } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const minutes = postReadingTime(post);
const href = postHref(post);
const isDev = import.meta.env.DEV;

const relatedServices = d.relatedServices
  .map((ref) => services.find((s) => s.slug === ref.id))
  .filter((s): s is (typeof services)[number] => !!s);
const relatedPosts = allPosts.filter((p) => p.id !== post.id && p.data.category === d.category).slice(0, 3);

const schema = Astro.site
  ? [
      blogPostingSchema({
        title: d.title,
        description: d.description,
        url: new URL(href, Astro.site),
        ...(d.cover && { image: new URL(d.cover.src, Astro.site).href }),
        datePublished: d.pubDate,
        ...(d.updatedDate && { dateModified: d.updatedDate }),
        author: d.author,
        siteUrl: Astro.site,
      }),
    ]
  : [];
---

<PageLayout
  title={d.seo?.title ?? d.title}
  description={d.seo?.description ?? d.description}
  heading={d.title}
  lead={postExcerpt(post)}
  breadcrumbs={[
    { label: 'Blog', href: '/blog' },
    { label: d.title, href },
  ]}
  annotations={blogHero.annotations}
  heroImage={heroImages.blog}
  type="article"
  publishedTime={d.pubDate}
  {...d.updatedDate && { modifiedTime: d.updatedDate }}
  noindex={d.seo?.noindex ?? false}
  schema={schema}
>
  {
    d.draft && isDev && (
      <div class="border-b border-dashed border-accent-500/60 bg-step-bg/40 py-2 text-center text-[11px] font-semibold text-primary-700">
        TODO-CONTENT · Taslak yazı (referans görselden örnek) — production'da yayınlanmaz
      </div>
    )
  }

  <section class="bg-white py-10 lg:py-12">
    <Container size="wide" class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_17.5rem] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_19rem]">
      <article class="min-w-0">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-muted">
          <li>
            <a href={categoryHref(d.category)} class="rounded-control bg-step-bg/70 px-3 py-1 font-semibold text-primary-800 hover:bg-step-bg">{d.category}</a>
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="services/project-management" size={15} strokeWidth={2} />
            <time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time>
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="_pending/user" size={15} strokeWidth={2} />
            {d.author}
          </li>
          <li class="inline-flex items-center gap-1.5">
            <Icon name="_pending/clock" size={15} strokeWidth={2} />
            {minutes} dk okuma
          </li>
        </ul>

        {
          d.cover && (
            <Picture
              src={d.cover}
              alt={d.coverAlt ?? ''}
              formats={['avif', 'webp']}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 60vw, 100vw"
              class="mt-6 aspect-[16/9] w-full rounded-card object-cover"
              loading="eager"
            />
          )
        }

        <div class="prose-akort mt-6 max-w-[46rem] text-[0.9375rem] leading-relaxed text-body">
          <Content />
        </div>

        {
          d.tags.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-2" aria-label="Etiketler">
              {d.tags.map((t) => (
                <li>
                  <a href={tagHref(t)} class="inline-block rounded-control bg-[#eaf2f8] px-2.5 py-1 text-xs text-primary-800 hover:bg-step-bg">
                    {t}
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        {
          relatedServices.length > 0 && (
            <aside class="card-surface mt-8 p-(--space-card)" aria-labelledby="related-services">
              <h2 id="related-services" class="text-h3 font-bold">
                İlgili Hizmetlerimiz
              </h2>
              <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                {relatedServices.map((s) => (
                  <li>
                    <a href={serviceHref(s.slug)} class="inline-flex items-center gap-2.5 text-small font-semibold text-primary-700 hover:underline">
                      <Icon name={s.icon} size={20} class="text-accent-600" />
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </article>

      <BlogSidebar posts={allPosts} activeCategory={d.category} />
    </Container>
  </section>

  {
    relatedPosts.length > 0 && (
      <section class="bg-surface-soft py-12 lg:py-11" aria-labelledby="related-posts">
        <Container size="wide">
          <p class="eyebrow">{d.category}</p>
          <h2 id="related-posts" class="mt-2 text-h2">
            İlgili Yazılar
          </h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((p) => (
              <li>
                <BlogGridCard
                  title={p.data.title}
                  excerpt={postExcerpt(p)}
                  category={p.data.category}
                  date={p.data.pubDate}
                  minutes={postReadingTime(p)}
                  href={postHref(p)}
                  image={p.data.cover}
                  imageAlt={p.data.coverAlt}
                />
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  <NewsletterBand />
</PageLayout>
