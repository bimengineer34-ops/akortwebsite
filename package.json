{
  "name": "akort-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "AKORT Mühendislik kurumsal web sitesi — özel tema (Astro + Tailwind CSS + TypeScript)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/copy-bim-assets.mjs && astro dev",
    "build": "node scripts/copy-bim-assets.mjs && astro check && astro build",
    "preview": "node scripts/copy-bim-assets.mjs && astro preview",
    "check": "astro check",
    "audit:seo": "node scripts/seo-audit.mjs",
    "astro": "astro",
    "start": "node server/index.mjs",
    "start:dev": "node --watch server/index.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@thatopen/components": "^3.4.8",
    "@thatopen/components-front": "^3.4.4",
    "@thatopen/fragments": "~3.4.7",
    "astro": "^7.3.5",
    "camera-controls": "^3.1.2",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "web-ifc": "0.0.77",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3"
  }
}
