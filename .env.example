# Kopyalayıp .env olarak kaydedin (git'e eklenmez). Boş bırakılırsa ilgili form veri göndermez, kullanıcıya bunu bildirir.
PUBLIC_SITE_URL=https://www.akortmuhendislik.com
# İletişim formu: JSON/FormData kabul eden POST uç noktası (ör. Formspree: https://formspree.io/f/xxxxxxx)
PUBLIC_CONTACT_ENDPOINT=
# Bülten aboneliği uç noktası
PUBLIC_NEWSLETTER_ENDPOINT=

# Sunucu (yönetim paneli) — bkz. docs/DEPLOY.md
PORT=4321
TRUST_PROXY=false
SECURE_COOKIES=false

# E-posta bildirimi (yeni form talebi). Boş bırakılırsa bildirim gönderilmez.
# Alıcılar panelden: Ayarlar (e-posta). 465 = SSL/TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AKORT Mühendislik <bildirim@alanadiniz.com>"

# Sır kasası ana anahtarı (isteğe bağlı, >=24 karakter). Boşsa data/.vault-key dosyası otomatik üretilir — yedeğini alın, kaybederseniz kayıtlı API anahtarları çözülemez.
SECRETS_KEY=
